# Copy this file to .env.local (local dev) and fill in real values.
# See workflows/05-env-vars.md for which of these belong in Vercel vs Trigger.dev.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers (spec §5: provider abstraction, OpenAI is default/primary here) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Search / contact-data provider (spec §14 — no real provider selected yet) ---
SEARCH_API_KEY=

# --- Company-sourcing provider (spec §11A — no real provider selected yet; a separate concern/key from SEARCH_API_KEY above) ---
SOURCING_API_KEY=

# --- Email (spec §20) ---
RESEND_API_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Mock mode (spec §29) — keep all four "true" until you deliberately wire a real provider ---
MOCK_AI=true
MOCK_SEARCH=true
MOCK_SOURCING=true
MOCK_EMAIL=true

# --- Cost controls (spec §28) ---
MAX_PAGES_PER_COMPANY=15
MAX_COMPANIES_PER_CAMPAIGN=200
MAX_COMPANIES_PER_SOURCING_RUN=50
MAX_AGENT_RETRIES=3
MAX_CONCURRENT_REQUESTS=5

# --- Trigger.dev (Vercel-side: lets the frontend call tasks.trigger()) ---
# Dev secret key from the Trigger.dev dashboard -> Project Settings -> API Keys.
# Use the "dev" key for local `next dev`, the "prod" key once deployed to Vercel.
TRIGGER_SECRET_KEY=
